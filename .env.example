# Copy to .env.local (git-ignored). Every value is optional.
#
# VITE_AI_PROVIDER   mock | http        (default: mock — deterministic, offline, no key needed)
# VITE_AI_ENDPOINT   URL of the LLM API. src/ai/provider.js speaks two wire formats:
#                      Anthropic Messages, when the host is *.anthropic.com
#                        e.g. https://api.anthropic.com/v1/messages
#                      OpenAI-compatible chat completions, for anything else
#                        e.g. https://api.openai.com/v1/chat/completions
#                             http://localhost:11434/v1/chat/completions (Ollama)
# VITE_AI_API_KEY    key for that API (never commit a real key; VITE_ values end up in the browser bundle)
# VITE_AI_MODEL      model name; defaults to claude-sonnet-5 for the Anthropic endpoint
VITE_AI_PROVIDER=mock
VITE_AI_ENDPOINT=
VITE_AI_API_KEY=
VITE_AI_MODEL=
